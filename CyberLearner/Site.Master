<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.Master.cs" Inherits="CyberLearner.SiteMaster" %>
<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title><%: Page.Title %> - CyberLearner</title>
    <link href="<%= ResolveUrl("~/Styles/site.css") %>" rel="stylesheet" />
    <asp:ContentPlaceHolder ID="HeadContent" runat="server" />
</head>
<body>
    <form id="form1" runat="server">
        <header class="site-header">
            <div class="container header-row">
                <a class="brand" href="<%= ResolveUrl("~/Default.aspx") %>">Cyber<span>Learner</span></a>
                <button type="button" class="nav-toggle" onclick="toggleMenu()">Menu</button>
                <nav id="mainNav" class="main-nav">
                    <a href="<%= ResolveUrl("~/Default.aspx") %>">Home</a>
                    <a href="<%= ResolveUrl("~/Register.aspx") %>">Register</a>
                    <a href="<%= ResolveUrl("~/Login.aspx") %>">Login</a>
                </nav>
            </div>
        </header>
        <main class="container">
            <asp:ContentPlaceHolder ID="MainContent" runat="server" />
        </main>
        <footer class="site-footer">
            <p>&copy; <%: DateTime.Now.Year %> CyberLearner - Cybersecurity Fundamentals</p>
        </footer>
    </form>
    <script src="<%= ResolveUrl("~/Scripts/site.js") %>"></script>
</body>
</html>
